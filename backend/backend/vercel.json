{
  "version": 2,
  "regions": ["icn1"],
  "installCommand": "npm ci",
  "buildCommand": "npm run vercel-build",
  "functions": {
    "api/**/*.ts": {
      "runtime": "@vercel/node@3.0.0",
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index.ts"
    }
  ],
  "env": {
    "NODE_ENV": "production",
    "NPM_CONFIG_CACHE": "/tmp/.npm"
  }
}
