{
  "version": 2,
  "regions": ["icn1"],
  "installCommand": "npm ci",
  "buildCommand": "npm run vercel-build",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 30,
      "runtime": "nodejs18.x"
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index.ts"
    }
  ],
  "env": {
    "NODE_ENV": "production",
    "NPM_CONFIG_CACHE": "/tmp/.npm"
  }
}